#: src/utils/ErrorBoundary.jsx:25
#, javascript-format
msgid "An error ocurred in WebApps: \"${ error }\", see details below."
msgstr "Se produjo un error en las aplicaciones web: «${ error }»; encuentre más abajo los detalles."

#: src/utils/ErrorBoundary.jsx:33
msgid "An Error Occurred - Available Applications | Turris"
msgstr "Se produjo un error – Aplicaciones disponibles | Turris"

#: src/utils/ErrorBoundary.jsx:37
msgid "Oops! Something went wrong:"
msgstr "Se ha producido un problema:"

#: src/utils/ErrorBoundary.jsx:43
msgid "More detailed information is available in the console of your web browser. On most browsers accessible after pressing <kbd><kbd>Ctrl</kbd>+<kbd>Shift</kbd>+<kbd>J</kbd></kbd> or <kbd>F12</kbd>."
msgstr "Hallará más información a detalle en la consola del navegador web. Acceda a ella en la mayoría de navegadores con las teclas <kbd><kbd>Ctrl</kbd>+<kbd>Mayús</kbd>+<kbd>J</kbd></kbd> o <kbd>F12</kbd>."

#: src/utils/ErrorBoundary.jsx:48
msgid "Please report this error to our support team via e-mail: <a href=\"mailto:tech.support@turris.cz\">tech.support@turris.cz</a>."
msgstr "Informe de este error a nuestro equipo de asistencia por correo electrónico (en inglés): <a href=\"mailto:tech.support@turris.cz\">tech.support@turris.cz</a>."

